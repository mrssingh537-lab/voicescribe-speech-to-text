# VoiceScribe Backend Configuration

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Provider & Model Settings
# Supported: "local" (default offline Whisper) or "api" (cloud-based Whisper API)
TRANSCRIPTION_MODE=local
WHISPER_MODEL=turbo
# Device: "auto" (detects CUDA float16 if available, else CPU float32), "cpu", or "cuda"
DEVICE=auto

# API Provider Settings (Required when TRANSCRIPTION_MODE=api)
# Store your OpenAI or Groq API key here:
TRANSCRIPTION_API_KEY=
# Endpoint URL (e.g. OpenAI https://api.openai.com/v1/audio/transcriptions or Groq https://api.groq.com/openai/v1/audio/transcriptions)
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
# Model identifier for the API (e.g. whisper-1 for OpenAI, whisper-large-v3 for Groq)
TRANSCRIPTION_API_MODEL=whisper-1

# Upload Limits
MAX_UPLOAD_SIZE_MB=500

# Optional HuggingFace Token for pyannote.audio diarization
# If not provided, VoiceScribe automatically falls back to lightweight local MFCC clustering diarization
HF_TOKEN=

# Storage & Database
DATABASE_URL=sqlite:///./storage/voicescribe.db
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
